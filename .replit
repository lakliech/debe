modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CLERK_ORGS_DISABLED = "true"
PLATFORM_ADMIN_EMAILS = "jaredkoyier@gmail.com"
GEO_REPAIR_TOKEN = "2d7a985bf73ac358fa2794fa72907f2b558849bbb2c9939c704450919610d815"

[userenv.production]
CORS_ORIGINS = "https://debe.ke"
ADMIN_CLEANUP_SECRET = "debe-cleanup-2026-demo"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21266
externalPort = 3000

[[ports]]
localPort = 25378
externalPort = 3001
