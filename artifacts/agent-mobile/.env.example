# ─────────────────────────────────────────────────────────────────────────────
# Linda Mwananchi Agent — environment variables
#
# Copy this file to .env.local for local development.
# For a per-campaign production build, see docs/mobile-campaign-build.md.
#
# All EXPO_PUBLIC_* values are inlined at build time by Metro bundler and
# shipped inside the compiled JavaScript bundle.  Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Clerk publishable key for this Expo app (starts with pk_test_ or pk_live_).
# In the Replit dev environment this is injected automatically from the
# CLERK_PUBLISHABLE_KEY secret; set it explicitly for standalone / CI builds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Hostname of the API server (no scheme, no trailing slash).
# Dev:  set to $REPLIT_DEV_DOMAIN by the pnpm dev script automatically.
# Prod: your deployed API domain, e.g.  api.ushindi.app
EXPO_PUBLIC_DOMAIN=api.ushindi.app

# ── Campaign white-labelling (per-campaign APK) ───────────────────────────────
#
# Set EXPO_PUBLIC_TENANT_SLUG to the campaign slug baked into this APK.
# The slug is the short identifier created when the campaign was set up in the
# platform admin console (e.g. "amina2027", "waweru-nairobi").
#
# Effect: the sign-in screen fetches /api/config/branding?x-tenant-slug=<value>
# before the user logs in, so the correct candidate name, primary colour, and
# logo are shown from first launch — no grey "Campaign Agent" placeholder.
#
# Leave blank (or omit) for a generic multi-campaign build where branding is
# resolved from the user's active Clerk organisation after sign-in.
EXPO_PUBLIC_TENANT_SLUG=

# ── Optional / advanced ───────────────────────────────────────────────────────

# Clerk proxy URL (set automatically to the Replit dev tunnel in pnpm dev).
# Only needed if you run your own Clerk proxy in production.
# EXPO_PUBLIC_CLERK_PROXY_URL=

# Replit repl ID — injected automatically in Replit environments.
# EXPO_PUBLIC_REPL_ID=
