# ─────────────────────────────────────────────────────────────────────────────
# Sample per-campaign environment file
#
# Rename this file (e.g. .env.amina2027) and fill in the values for your
# campaign before running `eas build`.  See docs/mobile-campaign-build.md
# for the full step-by-step guide.
# ─────────────────────────────────────────────────────────────────────────────

# The Clerk publishable key for your production Clerk instance.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# The hostname of your deployed API server (no scheme, no trailing slash).
EXPO_PUBLIC_DOMAIN=api.ushindi.app

# The campaign slug as it appears in the platform admin console.
# This value is baked into the APK at build time so the sign-in screen
# shows the correct candidate name and colour before the agent logs in.
EXPO_PUBLIC_TENANT_SLUG=REPLACE_WITH_CAMPAIGN_SLUG
