# Linda Mwananchi 2027 — Environment Variables Template
# Copy to .env and fill in the values.
# NEVER commit the filled-in .env file to version control.

# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/linda_db

# Clerk authentication — get from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── Optional: Object Storage (Google Cloud Storage) ───────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=private/
PUBLIC_OBJECT_SEARCH_PATHS=public/

# ── Optional: Security ─────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-32-byte-hex-string
# CORS_ORIGINS=https://yourapp.replit.app  # override in production

# ── Optional: M-Pesa (Safaricom Daraja API) ───────────────────────────────
# Leave blank to use sandbox mode (no real money)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=3033049
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourapp.replit.app/api/finance/mpesa/callback

# ── Node environment ───────────────────────────────────────────────────────
NODE_ENV=development
# PORT is set automatically by Replit
